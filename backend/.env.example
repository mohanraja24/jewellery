# Server Port & Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/jewellery_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_replace_with_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# Live Metal Rate Provider API (e.g. GoldAPI.io, Metals-API, or Indian Bullion API)
# Get a free API key at https://www.goldapi.io/
METAL_RATE_PROVIDER=goldapi
GOLDAPI_KEY=goldapi-your-key-here
RATE_CACHE_MINUTES=30
RATE_AUTO_UPDATE_ENABLED=true

# Razorpay Payment Gateway (Test mode credentials from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Cloudinary (Media storage credentials from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer / Transactional Email (SMTP credentials e.g., Gmail App Password or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM="Aurelia Fine Jewels <concierge@aureliajewels.com>"
